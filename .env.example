# Copy this file to .env (which is gitignored — never commit your real key) and fill in
# GEMINI_API_KEY to use scripts/content-generate.ts. Get a free-tier key at
# https://aistudio.google.com/apikey — see docs/content-generation.md for setup and usage.

GEMINI_API_KEY=

# Optional: overrides the DEFAULT_MODEL constant in scripts/content-generate.ts. Leave unset to
# use the script's default (a current Flash-class model).
# GEMINI_MODEL=gemini-2.0-flash
